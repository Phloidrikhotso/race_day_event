@model List<string[]>
@{
    ViewData["Title"] = "My results";
}

<h1 class="rd-title mb-3">My results</h1>

@if (ViewBag.message != null)
{
    <div class="alert alert-danger">@ViewBag.message</div>
}

@if (Model.Count == 0 && ViewBag.message == null)
{
    <div class="card rd-card p-4">
        <p class="mb-0">No results yet. Your race history appears here after an organizer publishes the results of an event you entered.</p>
    </div>
}
else if (Model.Count > 0)
{
    <div class="card rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Position</th>
                        <th>In category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (string[] row in Model)
                    {
                        <tr>
                            <td>@row[0]</td>
                            <td>@row[1]</td>
                            <td>@row[2]</td>
                            <td>@row[3]</td>
                            <td><strong>@row[4]</strong></td>
                            <td>@row[6]</td>
                            <td><span class="status-badge status-@(row[5].ToLower())">@row[5]</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
