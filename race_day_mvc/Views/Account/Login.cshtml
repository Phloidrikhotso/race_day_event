@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card rd-card p-4">
            <h2 class="rd-title mb-3">Log in to RaceDay</h2>

            @if (TempData["success"] != null)
            {
                <div class="alert alert-success">@TempData["success"]</div>
            }

            @if (ViewBag.message != null)
            {
                <div class="alert alert-danger">@ViewBag.message</div>
            }

            <form method="post" asp-controller="Account" asp-action="Login">
                <div class="mb-3">
                    <label class="form-label" for="email">Email</label>
                    <input class="form-control" type="email" id="email" name="email" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-control" type="password" id="password" name="password" required />
                </div>

                <button type="submit" class="btn rd-btn w-100">Log in</button>
            </form>

            <p class="mt-3 mb-0">
                New to RaceDay? <a asp-controller="Account" asp-action="Register">Create an account</a>
            </p>
        </div>
    </div>
</div>
