@model List<string[]>
@{
    ViewData["Title"] = "Results";

    List<string[]> events = ViewBag.events ?? new List<string[]>();
    string[]? selected = ViewBag.selected_event;

    string[] statuses = { "Finished", "DNF", "DSQ", "DNS" };
}

<h1 class="rd-title mb-3">Results</h1>

@if (ViewBag.message != null)
{
    <div class="alert alert-danger">@ViewBag.message</div>
}

@if (events.Count == 0 && ViewBag.message == null)
{
    <div class="card rd-card p-4">
        <p>You need an event before you can capture results.</p>
        <div><a class="btn rd-btn" asp-controller="Organizer" asp-action="CreateEvent">Create an event</a></div>
    </div>
}
else if (events.Count > 0)
{
    <form method="get" asp-controller="Organizer" asp-action="Results" class="filter-bar p-3 mb-4">
        <label class="form-label" for="event_id">Choose an event</label>
        <select class="form-select" id="event_id" name="event_id" onchange="this.form.submit()">
            <option value="">-- Select an event --</option>
            @foreach (string[] ev in events)
            {
                <option value="@ev[0]" selected="@(selected != null && selected[0] == ev[0])">@ev[1] (@ev[3])</option>
            }
        </select>
    </form>

    @if (selected != null)
    {
        <h3 class="rd-title mb-1">@selected[1]</h3>
        <p class="text-muted">Finish times look like 01:23:45. Positions are optional. Saving a row creates or updates that participant's result.</p>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">Nobody is enrolled in this event, so there is nothing to capture yet.</div>
        }
        else
        {
            <div class="card rd-card p-3">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Saved result</th>
                                <th>Finish time</th>
                                <th>Overall</th>
                                <th>Category pos.</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (string[] row in Model)
                            {
                                string form_id = "result_form_" + row[0];
                                string current_status = string.IsNullOrEmpty(row[6]) ? "Finished" : row[6];

                                <tr>
                                    <td>
                                        @row[1]
                                        <form id="@form_id" method="post" asp-controller="Organizer" asp-action="SaveResult">
                                            <input type="hidden" name="event_id" value="@selected[0]" />
                                            <input type="hidden" name="enrolment_id" value="@row[0]" />
                                        </form>
                                    </td>
                                    <td><span class="type-badge type-@(row[2].ToLower())">@row[2]</span></td>
                                    <td>
                                        @if (string.IsNullOrEmpty(row[6]))
                                        {
                                            <span class="text-muted">Not captured</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-@(row[6].ToLower())">@row[6]</span>
                                        }
                                    </td>
                                    <td><input form="@form_id" class="form-control form-control-sm" name="finish_time" value="@row[3]" placeholder="HH:MM:SS" style="min-width:100px" /></td>
                                    <td><input form="@form_id" class="form-control form-control-sm" name="overall_position" value="@row[4]" style="width:80px" /></td>
                                    <td><input form="@form_id" class="form-control form-control-sm" name="category_position" value="@row[5]" style="width:80px" /></td>
                                    <td>
                                        <select form="@form_id" class="form-select form-select-sm" name="results_status">
                                            @foreach (string status in statuses)
                                            {
                                                <option value="@status" selected="@(current_status == status)">@status</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-end">
                                        <button form="@form_id" type="submit" class="btn rd-btn btn-sm">Save</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
