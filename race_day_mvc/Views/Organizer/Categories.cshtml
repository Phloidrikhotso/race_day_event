@model List<string[]>
@{
    ViewData["Title"] = "Categories";

    List<string[]> events = ViewBag.events ?? new List<string[]>();
    string[]? selected = ViewBag.selected_event;
}

<h1 class="rd-title mb-3">Categories</h1>

@if (ViewBag.message != null)
{
    <div class="alert alert-danger">@ViewBag.message</div>
}

@if (events.Count == 0 && ViewBag.message == null)
{
    <div class="card rd-card p-4">
        <p>You need an event before you can add categories.</p>
        <div><a class="btn rd-btn" asp-controller="Organizer" asp-action="CreateEvent">Create an event</a></div>
    </div>
}
else if (events.Count > 0)
{
    <form method="get" asp-controller="Organizer" asp-action="Categories" class="filter-bar p-3 mb-4">
        <label class="form-label" for="event_id">Choose an event</label>
        <select class="form-select" id="event_id" name="event_id" onchange="this.form.submit()">
            <option value="">-- Select an event --</option>
            @foreach (string[] ev in events)
            {
                <option value="@ev[0]" selected="@(selected != null && selected[0] == ev[0])">@ev[1] (@ev[3])</option>
            }
        </select>
    </form>

    @if (selected != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="rd-title mb-0">@selected[1]</h3>
            <a class="btn rd-btn" asp-controller="Organizer" asp-action="CreateCategory" asp-route-event_id="@selected[0]">Add category</a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">This event has no categories yet. Add one for each distance participants can pick from.</div>
        }
        else
        {
            <div class="card rd-card p-3">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Distance</th>
                                <th>Entry fee</th>
                                <th>Max participants</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (string[] category in Model)
                            {
                                <tr>
                                    <td><span class="type-badge type-@(category[1].ToLower())">@category[1]</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(category[3]) ? "-" : category[3] + " km")</td>
                                    <td>@("R" + category[2])</td>
                                    <td>@category[4]</td>
                                    <td class="text-end">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Organizer" asp-action="EditCategory"
                                               asp-route-id="@category[0]" asp-route-event_id="@selected[0]">Edit</a>
                                            <form method="post" asp-controller="Organizer" asp-action="DeleteCategory"
                                                  asp-route-id="@category[0]" asp-route-event_id="@selected[0]"
                                                  onsubmit="return confirm('Delete this category?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
