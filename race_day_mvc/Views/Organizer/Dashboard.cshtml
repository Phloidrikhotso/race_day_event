@model List<string[]>
@{
    ViewData["Title"] = "Dashboard";
    string? first_name = Context.Session.GetString("first_name");
}

<section class="rd-hero rd-hero-slim text-center mb-4">
    <h1>Welcome back, @first_name</h1>
    <p class="lead mb-0">Here is how your events are doing.</p>
</section>

@if (ViewBag.message != null)
{
    <div class="alert alert-danger">@ViewBag.message</div>
}

<div class="row mb-4">
    <div class="col-6 col-md-3 mb-3">
        <div class="card rd-card p-3 text-center h-100">
            <div class="rd-title display-6">@ViewBag.total_events</div>
            <div>Total events</div>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card rd-card p-3 text-center h-100">
            <div class="rd-title display-6">@ViewBag.open_events</div>
            <div>Open for enrolment</div>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card rd-card p-3 text-center h-100">
            <div class="rd-title display-6">@ViewBag.planned_events</div>
            <div>Planned</div>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card rd-card p-3 text-center h-100">
            <div class="rd-title display-6">@ViewBag.total_enrolments</div>
            <div>Total enrolments</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="rd-title mb-0">Upcoming events</h3>
    <div>
        <a class="btn rd-btn" asp-controller="Organizer" asp-action="CreateEvent">Create event</a>
        <a class="btn btn-outline-secondary" asp-controller="Organizer" asp-action="Events">All my events</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have no upcoming events yet.</div>
}
else
{
    <div class="card rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Enrolments</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (string[] ev in Model)
                    {
                        <tr>
                            <td>@ev[1]</td>
                            <td>@ev[3]</td>
                            <td>@ev[4]</td>
                            <td><span class="status-badge status-@(ev[7].ToLower())">@ev[7]</span></td>
                            <td>@ev[8]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
